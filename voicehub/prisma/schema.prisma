generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum JobKind {
  STT
  TTS
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AssetKind {
  AUDIO_UPLOAD
  AUDIO_OUTPUT
  TEXT_UPLOAD
  TRANSCRIPT_EXPORT
}

enum UsageFeature {
  STT
  TTS
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         UserRole     @default(USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sessions     Session[]
  jobs         Job[]
  assets       MediaAsset[]
  transcripts  Transcript[]
  voiceOutputs VoiceOutput[]
  usageLogs    UsageLog[]
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id            String       @id @default(cuid())
  userId        String
  kind          JobKind
  status        JobStatus    @default(QUEUED)
  provider      String
  model         String
  title         String?
  sourceAssetId String?
  outputAssetId String?
  errorMessage  String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAsset   MediaAsset?  @relation("JobSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  outputAsset   MediaAsset?  @relation("JobOutputAsset", fields: [outputAssetId], references: [id], onDelete: SetNull)
  transcript    Transcript?
  voiceOutput   VoiceOutput?
  usageLogs     UsageLog[]

  @@index([userId, kind, createdAt])
  @@index([status, createdAt])
}

model MediaAsset {
  id                  String        @id @default(cuid())
  userId              String
  kind                AssetKind
  originalName        String
  fileName            String
  mimeType            String
  extension           String
  sizeBytes           Int
  storageKey          String        @unique
  checksum            String?
  createdAt           DateTime      @default(now())
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceJobs          Job[]         @relation("JobSourceAsset")
  outputJobs          Job[]         @relation("JobOutputAsset")
  sourceTranscripts   Transcript[]  @relation("TranscriptSourceAsset")
  sourceVoiceOutputs  VoiceOutput[] @relation("VoiceOutputSourceAsset")
  outputVoiceOutputs  VoiceOutput[] @relation("VoiceOutputOutputAsset")

  @@index([userId, kind, createdAt])
}

model Transcript {
  id               String              @id @default(cuid())
  userId           String
  jobId            String              @unique
  sourceAssetId    String?
  title            String
  languageCode     String?
  languageName     String?
  detectedLanguage String?
  text             String              @db.Text
  durationSeconds  Float?
  speakerCount     Int?
  hasDiarization   Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceAsset      MediaAsset?         @relation("TranscriptSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  segments         TranscriptSegment[]

  @@index([userId, createdAt])
}

model TranscriptSegment {
  id           String     @id @default(cuid())
  transcriptId String
  segmentIndex Int
  startMs      Int
  endMs        Int
  speakerLabel String?
  text         String     @db.Text
  transcript   Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@index([transcriptId, segmentIndex])
}

model VoiceOutput {
  id              String      @id @default(cuid())
  userId          String
  jobId           String      @unique
  sourceAssetId   String?
  outputAssetId   String?
  title           String
  text            String      @db.Text
  voice           String
  speed           Float       @default(1)
  pitch           String?
  outputFormat    String
  durationSeconds Float?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceAsset     MediaAsset? @relation("VoiceOutputSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  outputAsset     MediaAsset? @relation("VoiceOutputOutputAsset", fields: [outputAssetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model UsageLog {
  id          String       @id @default(cuid())
  userId      String
  jobId       String?
  feature     UsageFeature
  provider    String
  model       String
  inputUnits  Int?
  outputUnits Int?
  costUsd     Float?
  metadata    Json?
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, feature, createdAt])
}
